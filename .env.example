# Environment for the seli CLI and its build. Copy to .env and fill in; .env is
# gitignored and must never be committed. Placeholders only in this file: the API
# host is configuration, never code, and it will change.

# --- Runtime: read by the `seli` binary ---------------------------------------

# Where the API lives: the host only (https), with no path. The CLI adds each
# endpoint's /api/... path itself. Precedence: --api-url, then this variable,
# then the active profile's api_url, then the default baked into the binary
# (SELI_DEFAULT_API_URL below; `seli version` prints it).
SELI_API_URL=https://<seli-platform-host>

# Your API key (starts with ssk_). Overrides the key stored by `seli auth login`.
SELI_API_KEY=ssk_<your-key>

# Tenant to act on when --tenant is not given. Overrides `seli config
# set-default-tenant`.
SELI_TENANT=<tenant-code>

# --- Build and maintenance: read by make and GoReleaser, not by the binary ----

# The API host baked into the binary as its last-resort default, via
# -ldflags -X .../internal/version.DefaultAPIURL. Same form as SELI_API_URL.
# Leave unset for a binary that must be told the host at runtime. Releases take
# it from the GitHub repository variable of the same name.
SELI_DEFAULT_API_URL=https://<seli-platform-host>

# Where `make update-spec` fetches the OpenAPI document from. Defaults to
# $SELI_DEFAULT_API_URL/api/openapi when that is set.
SELI_SPEC_URL=https://<seli-platform-host>/api/openapi
